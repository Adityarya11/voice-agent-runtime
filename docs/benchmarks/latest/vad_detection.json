  "utterances": {
    "u01": {
      "text": "Hello.",
      "speech_s": 0.476875
    },
    "u02": {
      "text": "Hi, I'd like to book an appointment.",
      "speech_s": 2.109
    },
    "u03": {
      "text": "Yes, I'm a returning patient.",
      "speech_s": 1.61925
    },
    "u04": {
      "text": "No, this is my first visit.",
      "speech_s": 1.573875
    },
    "u05": {
      "text": "Can I come in tomorrow morning?",
      "speech_s": 1.4535
    },
    "u06": {
      "text": "What are your opening hours on weekends?",
      "speech_s": 1.900625
    },
    "u07": {
      "text": "Where is the clinic located, and is there parking nearby?",
      "speech_s": 3.04975
    },
    "u08": {
      "text": "Thanks, that's all I needed.",
      "speech_s": 1.548625
    },
    "u09": {
      "text": "My tooth has been hurting since last night, and I think I need to see someone as soon as possible.",
      "speech_s": 4.82675
    },
    "u10": {
      "text": "Do you accept dental insurance, and if so, which providers do you work with?",
      "speech_s": 4.161875
    },
    "u11": {
      "text": "I need to reschedule my cleaning from Thursday to sometime next week, preferably in the afternoon after two.",
      "speech_s": 5.572
    },
    "u12": {
      "text": "Actually, could you tell me how much a regular checkup costs without insurance, and whether you offer payment plans for bigger treatments like crowns or root canals?",
      "speech_s": 8.615
    }
  },
